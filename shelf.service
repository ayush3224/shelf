[Unit]
Description=Shelf Voice Capture API
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/shelf
Environment="PATH=/root/shelf/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/root/shelf/.env
ExecStart=/root/shelf/venv/bin/python -m backend.main
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
