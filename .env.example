# Database
DATABASE_URL=postgresql://user:password@localhost:5432/postgres
DB_SCHEMA=shelf

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Supabase
# SUPABASE_URL and SUPABASE_SERVICE_KEY are what store and sign the raw audio
# (UC7). Without them /capture/audio returns 503 rather than dropping a
# recording it cannot keep.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=shelf-audio
# How long a playback URL stays valid. The bucket holds the user's voice, so
# these are minted per request rather than stored on the row.
AUDIO_URL_TTL_SECONDS=3600

# Transcription (UC8) — Whisper served by Groq (D24). The endpoint is
# OpenAI-compatible, so another host is a GROQ_API_BASE change and nothing else.
# GROQ_MODEL: whisper-large-v3-turbo (faster) or whisper-large-v3 (more
# accurate). The free tier covers this volume, so the choice is latency.
# Groq bills a 10-second minimum per request and its free tier caps uploads at
# 25MB; neither binds here — MAX_AUDIO_BYTES is 10MB, matched to the bucket.
# A 429 is retried with backoff (D25) rather than costing the capture its words.
# GROQ_LANGUAGE is pinned rather than detected (D23) — detection is a guess from
# the first seconds of audio, and a wrong guess returns confident nonsense
# rather than an error. Blank re-enables detection.
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo
GROQ_LANGUAGE=en
# Below this confidence the transcript is kept but flagged needs_review (D22).
# Calibrated on real recordings, which sit at 0.70-0.76 even when perfect (D27).
TRANSCRIPT_CONFIDENCE_FLOOR=0.5

# Google Calendar (UC43) — one-way: timed items are projected onto the owner's
# calendar and nothing is ever read back (D8).
#
# A *service account*, not the OAuth user flow (D52): create one, download its
# JSON key, and share the calendar with the service account's address from
# Google Calendar's own sharing settings, with "Make changes to events". There
# is no consent screen and no refresh token to store — just this file and the
# calendar id below.
#
# The key file is a credential. It is gitignored; keep it out of the repo.
GOOGLE_CALENDAR_KEY_FILE=google-calendar-key.json
# The calendar to write to — normally the owner's own address. Leave it empty
# to turn the sync off entirely; the tick then skips the step rather than
# failing it every minute.
GOOGLE_CALENDAR_ID=
# How long each event blocks out. Items are moments, not meetings, and the
# events are transparent so they never mark you busy.
GOOGLE_CALENDAR_EVENT_MINUTES=15
GOOGLE_CALENDAR_BATCH_LIMIT=20
# Failed syncs stop being retried after this many goes. Reset to zero whenever
# the item is next edited, so giving up is never permanent.
GOOGLE_CALENDAR_MAX_ATTEMPTS=5

# Push (UC23) — Expo's push service in front of FCM. The Google credential
# (the FCM V1 service account key) lives in the EAS dashboard, not here: the
# app is Expo, so the token is an ExponentPushToken and Expo is what holds the
# key. EXPO_ACCESS_TOKEN is only needed if push security is enabled on the
# Expo account; without it the send endpoint accepts unauthenticated requests.
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=
# The channel and category the app registers. The server names both on every
# message, so these two values are an agreement between the two halves — the
# Done and Snooze buttons only appear if the category name matches exactly.
PUSH_CHANNEL_ID=reminders
PUSH_CATEGORY_ID=shelf.reminder
# How long an unanswered push waits before the next one is due — and with it,
# the write that reads the silence as `ignored` (D32). With
# SHELVE_AFTER_IGNORES at 3, this is what decides how fast decay actually runs:
# an item nobody touches shelves after three of these, so four hours puts that
# most of a day out. It was one hour until 24 August 2026, which shelved things
# inside a single long meeting — an interruption, not a pattern (D40).
PUSH_REPEAT_MINUTES=240
# Default snooze. The app may ask for another value; past the ceiling it is
# refused rather than quietly shortened.
SNOOZE_MINUTES=30
MAX_SNOOZE_MINUTES=10080
# Cap on one tick's sends, so a first run against a backlog is not a hundred
# notifications at once.
PUSH_BATCH_LIMIT=20
# After this many failed sends a queued push stalls rather than retrying
# forever. It is never marked sent, so nothing decays from it (D32).
PUSH_MAX_ATTEMPTS=5

# The weekly digest (UC31). UC22 was dropped, so decay is silent and this is
# the only place it becomes visible — which makes these constants load-bearing
# rather than cosmetic.
# The day and the local hour it lands. The hour is in CAPTURE_TIMEZONE, not the
# server's UTC. An unrecognised day falls back to sunday and says so in the log.
DIGEST_DAY=sunday
DIGEST_HOUR=9
# How far ahead the digest warns that something is about to be dropped. Two
# digest cycles, not one: at seven days an item gets exactly one warning, and a
# week you did not read it is a week it dropped unannounced.
DIGEST_WARN_DAYS=14
# A digest is a snapshot of a week. If it could not be delivered within this
# long of the week ending, it is abandoned rather than sent late — the opposite
# of the rule for item pushes (D32), because a due item is still due whenever
# the reminder arrives and a summary of a week you are halfway through is not.
DIGEST_MAX_AGE_HOURS=24
DIGEST_MAX_ATTEMPTS=5
# Rows per section on the digest screen; past this it says how many more.
DIGEST_LIST_LIMIT=20
# Its own Android channel, separate from PUSH_CHANNEL_ID. The reminder channel
# is HIGH importance because a due item is a moment that has arrived; a weekly
# summary is not, and sharing the channel is how the important one gets muted.
DIGEST_CHANNEL_ID=digest

# CallMeBot (phase 7, optional)
CALLMEBOT_USER=

# API
API_PORT=8001

# Behaviour
# Timezone relative dates in a capture ("tomorrow 3pm") resolve against.
# CAPTURE_TIMEZONE is accepted as an alias; TZ wins if both are set.
TZ=Asia/Kolkata
SHELVE_AFTER_IGNORES=3
# A split re-prompt returns an array, so it cannot fit the 200-token cap the
# common parse is held to (D19).
MAX_SPLIT_TOKENS=600
MAX_SPLIT_ITEMS=10
DROP_AFTER_DAYS=90
QUIET_HOURS_START=22
QUIET_HOURS_END=7
