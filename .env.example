# Database
DATABASE_URL=postgresql://user:password@localhost:5432/postgres
DB_SCHEMA=shelf

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=audio

# Google Calendar (phase 5)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Push
FCM_SERVER_KEY=

# CallMeBot (phase 7, optional)
CALLMEBOT_USER=

# API
API_PORT=8001

# Behaviour
# Timezone relative dates in a capture ("tomorrow 3pm") resolve against.
# CAPTURE_TIMEZONE is accepted as an alias; TZ wins if both are set.
TZ=Asia/Kolkata
SHELVE_AFTER_IGNORES=3
DROP_AFTER_DAYS=90
QUIET_HOURS_START=22
QUIET_HOURS_END=7
