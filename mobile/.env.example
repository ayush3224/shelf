# Expo inlines EXPO_PUBLIC_* into the JS bundle. Nothing secret goes here —
# the anon key is a publishable key and the API is the only thing holding
# a service key.

# Shelf API. No trailing slash.
EXPO_PUBLIC_API_BASE_URL=https://srv1531684.hstgr.cloud/api

# Supabase — same project the backend verifies tokens against.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
